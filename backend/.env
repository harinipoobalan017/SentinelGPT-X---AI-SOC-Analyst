# ══════════════════════════════════════════════
#  SentinelGPT X — Backend Environment Variables
# ══════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB — use either local or Atlas
MONGODB_URI=mongodb://localhost:27017/sentinelgpt
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/sentinelgpt

# JWT
JWT_SECRET=sentinelgpt-super-secret-change-this-in-production-please
JWT_EXPIRES=7d

# AI Provider (optional — demo mode works without these)
# Uncomment and fill one:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
